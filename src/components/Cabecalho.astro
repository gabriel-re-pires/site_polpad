---
import { outroIdioma, rota, t, langHtml, type Idioma } from '../lib/i18n';
import { REPO_POLPAD } from '../lib/site';

interface Props {
  idioma: Idioma;
  alternativa: string;
}

const { idioma, alternativa } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<header class="cabecalho">
  <div class="conteiner barra">
    <a class="marca" href={rota(idioma, 'inicio')} aria-label={t(idioma, 'nav_inicio')}>
      <img src={`${base}polvo.svg`} alt="" width="32" height="32" />
      <span>Polpad</span>
    </a>
    <nav aria-label={t(idioma, 'nav_principal')}>
      <a href={rota(idioma, 'docs')}>{t(idioma, 'nav_docs')}</a>
      <a href={rota(idioma, 'comunidade')}>{t(idioma, 'nav_comunidade')}</a>
      <a href={rota(idioma, 'baixar')}>{t(idioma, 'nav_baixar')}</a>
    </nav>
    <div class="acoes">
      <a
        class="idioma"
        href={alternativa}
        hreflang={langHtml(outroIdioma(idioma))}
        lang={langHtml(outroIdioma(idioma))}
        title={t(idioma, 'nav_idioma')}>{t(idioma, 'nav_idioma_curto')}</a
      >
      <a class="github" href={REPO_POLPAD} aria-label={t(idioma, 'nav_github')}>
        <svg viewBox="0 0 16 16" width="20" height="20" aria-hidden="true" fill="currentColor">
          <path
            d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"
          ></path>
        </svg>
      </a>
    </div>
  </div>
</header>

<style>
  .cabecalho {
    border-bottom: 1px solid var(--cor-borda);
    background: color-mix(in srgb, var(--cor-fundo) 85%, transparent);
    backdrop-filter: blur(8px);
    position: sticky;
    top: 0;
    z-index: 10;
  }
  .barra {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    min-height: 64px;
  }
  .marca {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-weight: 600;
    font-size: 1.15rem;
    text-decoration: none;
  }
  nav {
    display: flex;
    gap: 1.25rem;
  }
  nav a,
  .idioma {
    color: var(--cor-texto-suave);
    text-decoration: none;
    font-weight: 600;
    font-size: 0.95rem;
  }
  nav a:hover,
  .idioma:hover,
  .github:hover {
    color: var(--cor-texto);
  }
  .acoes {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  .idioma {
    border: 1px solid var(--cor-borda);
    border-radius: 8px;
    padding: 0.2rem 0.55rem;
  }
  .github {
    color: var(--cor-texto-suave);
    display: flex;
  }
  @media (max-width: 640px) {
    .barra {
      flex-wrap: wrap;
      gap: 0.25rem 1rem;
      padding-block: 0.6rem;
    }
    nav {
      order: 3;
      width: 100%;
      gap: 1.1rem;
    }
  }
</style>
