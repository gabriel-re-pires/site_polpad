---
import { rota, t, type Idioma } from '../lib/i18n';
import { REPO_POLPAD } from '../lib/site';
import IconeGithub from './IconeGithub.astro';
import Macropad from './Macropad.astro';

interface Props {
  idioma: Idioma;
}

const { idioma } = Astro.props;
---

<section class="hero">
  <div class="conteiner painel">
    <div class="abertura">
      <h1>
        <span>{t(idioma, 'hero_linha1')}</span>
        <span>{t(idioma, 'hero_linha2')}</span>
      </h1>
      <p class="sub">{t(idioma, 'hero_sub')}</p>
      <div class="botoes">
        <a class="botao botao-primario botao-grande" href={rota(idioma, 'baixar')}>
          {t(idioma, 'hero_baixar')}
        </a>
        <a class="botao botao-escuro botao-grande" href={REPO_POLPAD}>
          <IconeGithub />
          {t(idioma, 'hero_github')}
        </a>
      </div>
    </div>

    <div class="vitrine">
      <Macropad idioma={idioma} />
    </div>
  </div>
</section>

<style>
  /* O roxo vai de ponta a ponta da tela e sobe por trás da barra de navegação: a seção
     começa no alto da página (a barra ocupa 10 px de margem mais a própria altura). */
  .hero {
    --sob-a-barra: calc(10px + var(--altura-cabecalho));
    margin-top: calc(-1 * var(--sob-a-barra));
    padding-top: calc(var(--sob-a-barra) + clamp(1rem, 3vw, 1.75rem));
    background: var(--cor-roxo);
    /* A sombra do macropad 3D passa um pouco do quadro: nunca cria rolagem lateral. */
    overflow-x: clip;
  }

  /* O painel, todo roxo: o título e os botões à esquerda e o macropad à direita. Embaixo
     sobra roxo para o cartão que passa da borda do macropad. */
  .painel {
    --margem: var(--gutter);
    position: relative;
    display: grid;
    row-gap: 2.5rem;
    padding-top: clamp(1rem, 3vw, 2rem);
    padding-bottom: clamp(4.25rem, 7vw, 5rem);
  }
  /* Lado a lado: o texto fica centralizado na altura do macropad. */
  @media (min-width: 960px) {
    .painel {
      grid-template-columns: 7fr 5fr;
    }
  }
  /* Só o título e os botões, direto sobre o roxo: o painel inteiro é roxo. */
  .abertura {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: clamp(1.75rem, 5vw, 3.5rem) 0.25rem;
    container-type: inline-size;
  }
  /* O título acompanha a largura do quadro: "Seu macropad," sempre cabe numa linha. */
  h1 {
    font-size: clamp(1.75rem, 10cqi, 4.4rem);
    font-weight: 800;
    line-height: 0.98;
    letter-spacing: -0.04em;
    margin: 0 0 1rem;
  }
  h1 span {
    display: block;
  }
  .sub {
    max-width: 30rem;
    margin: 0 0 2rem;
    color: rgb(255 255 255 / 0.88);
    font-size: clamp(1.05rem, 1.9vw, 1.25rem);
    line-height: 1.45;
  }
  .botoes {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .vitrine {
    display: grid;
    place-items: center;
    padding-inline: clamp(1rem, 3.5vw, 2.5rem);
  }

  @media (max-width: 480px) {
    .botoes {
      flex-direction: column;
    }
  }
</style>
