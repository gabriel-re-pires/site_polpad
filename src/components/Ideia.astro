---
// "O seu projeto amanhã": as próximas melhorias do Polpad e o convite para a
// comunidade mostrar o que montou.
import { t, type Idioma } from '../lib/i18n';
import { urlEnviarProjeto } from '../lib/links';

interface Props {
  idioma: Idioma;
}

const { idioma } = Astro.props;
---

<section class="conteiner ideia" aria-labelledby="ideia-titulo">
  <h2 id="ideia-titulo">{t(idioma, 'projeto_titulo')}</h2>
  <p>{t(idioma, 'projeto_intro')}</p>
  <p>{t(idioma, 'projeto_intro2')}</p>
  <div class="botoes">
    <a class="botao botao-primario botao-grande" href={urlEnviarProjeto(idioma)}>
      {t(idioma, 'previa_enviar')}
    </a>
  </div>
</section>

<style>
  .ideia {
    padding-block: var(--secao) 0;
  }
  .ideia h2 {
    margin: 0 0 clamp(1.75rem, 3.5vw, 2.5rem);
    font-size: clamp(2.1rem, 5.6vw, 4rem);
    line-height: 1;
    letter-spacing: -0.045em;
  }
  .ideia p {
    margin: 0 0 1.5rem;
    color: var(--cor-texto-corpo);
    font-size: clamp(1.02rem, 1.8vw, 1.2rem);
    line-height: 1.75;
    text-align: var(--alinhar-texto);
    hyphens: auto;
  }
  .botoes {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: clamp(2rem, 4vw, 2.75rem);
  }
  @media (max-width: 480px) {
    .botoes {
      flex-direction: column;
    }
  }
</style>
