---
import Base from '../../layouts/Base.astro';
import { outroIdioma, rota, t, type Idioma } from '../../lib/i18n';
import { DOWNLOADS, HARDWARE } from '../../lib/site';
import { urlInstalar, urlMontagem } from '../../lib/links';

interface Props {
  idioma: Idioma;
}

const { idioma } = Astro.props;
---

<Base
  idioma={idioma}
  titulo={t(idioma, 'baixar_titulo')}
  descricao={t(idioma, 'baixar_descricao')}
  alternativa={rota(outroIdioma(idioma), 'baixar')}>
  <section class="conteiner pagina">
    <header class="cabeca">
      <h1>{t(idioma, 'baixar_h1')}</h1>
      <p class="intro">{t(idioma, 'baixar_intro')}</p>
      <p class="versao" data-versao data-rotulo={t(idioma, 'baixar_versao_atual')} hidden></p>
    </header>

    <article class="bloco principal">
      <div class="texto">
        <h2>{t(idioma, 'baixar_software')}</h2>
        <p>{t(idioma, 'baixar_software_texto')}</p>
      </div>
      <div class="acoes">
        <p class="celular" data-celular hidden>{t(idioma, 'baixar_celular')}</p>
        <div class="botoes" data-sistemas>
          <a class="botao botao-primario botao-grande" data-sistema="windows" href={DOWNLOADS.windows}
            >{t(idioma, 'baixar_windows')}</a
          >
          <a class="botao botao-secundario botao-grande" data-sistema="linux" href={DOWNLOADS.linux}
            >{t(idioma, 'baixar_linux')}</a
          >
        </div>
        <p class="pequeno">
          <a href={urlInstalar(idioma)}>{t(idioma, 'baixar_como_instalar')}</a>
          <a href={DOWNLOADS.sha256}>{t(idioma, 'baixar_sha')}</a>
        </p>
      </div>
    </article>

    <div class="blocos">
      <article class="bloco">
        <h2>{t(idioma, 'baixar_hardware')}</h2>
        <p>{t(idioma, 'baixar_hardware_texto')}</p>
        <div class="botoes">
          <a class="botao botao-secundario" href={HARDWARE.caseTopo}>{t(idioma, 'baixar_case_topo')}</a>
          <a class="botao botao-secundario" href={HARDWARE.caseBase}>{t(idioma, 'baixar_case_base')}</a>
        </div>
        <p class="pequeno">
          <a href={HARDWARE.gcode}>{t(idioma, 'baixar_gcode')}</a>
          <a href={urlMontagem(idioma)}>{t(idioma, 'baixar_como_montar')}</a>
        </p>
      </article>

      <article class="bloco">
        <h2>{t(idioma, 'baixar_placa')}</h2>
        <p>{t(idioma, 'baixar_placa_texto')}</p>
        <div class="botoes">
          <a class="botao botao-secundario" href={HARDWARE.placa}>{t(idioma, 'baixar_placa_link')}</a>
        </div>
      </article>

      <article class="bloco">
        <h2>{t(idioma, 'baixar_firmware')}</h2>
        <p>{t(idioma, 'baixar_firmware_texto')}</p>
        <p class="pequeno empurra">
          <a data-firmware href={DOWNLOADS.firmwareReserva}>{t(idioma, 'baixar_firmware_avancado')}</a>
        </p>
      </article>
    </div>

    <aside class="primeira-vez">
      <div>
        <h2>{t(idioma, 'baixar_primeira_vez')}</h2>
        <p>{t(idioma, 'baixar_primeira_vez_texto')}</p>
      </div>
      <a class="link-seta" href={urlMontagem(idioma)}>
        {t(idioma, 'baixar_primeira_vez_link')}
      </a>
    </aside>
  </section>
</Base>

<script>
  import '../../scripts/versao';

  // Quem está no Linux vê o botão do Linux em destaque. Na dúvida, fica o do Windows.
  const ua = navigator.userAgent;
  const linux = /Linux|X11/.test(ua) && !/Android/.test(ua);
  // No celular o instalador não serve: avisa antes dos botões.
  if (/Android|iPhone|iPad|iPod/.test(ua)) {
    const aviso = document.querySelector<HTMLElement>('[data-celular]');
    if (aviso) aviso.hidden = false;
  }
  if (linux) {
    const caixa = document.querySelector<HTMLElement>('[data-sistemas]');
    const win = caixa?.querySelector<HTMLElement>('[data-sistema="windows"]');
    const lin = caixa?.querySelector<HTMLElement>('[data-sistema="linux"]');
    if (caixa && win && lin) {
      win.classList.replace('botao-primario', 'botao-secundario');
      lin.classList.replace('botao-secundario', 'botao-primario');
      caixa.prepend(lin);
    }
  }
</script>

<style>
  .pagina {
    padding-block: clamp(2.5rem, 6vw, 4.5rem) 0;
  }
  .cabeca {
    max-width: 44rem;
    margin-bottom: clamp(2rem, 5vw, 3rem);
  }
  h1 {
    font-size: clamp(2.2rem, 6vw, 3.6rem);
    letter-spacing: -0.03em;
    margin-bottom: 0.75rem;
  }
  .intro {
    color: var(--cor-texto-suave);
    font-size: clamp(1.05rem, 2vw, 1.2rem);
    margin: 0;
  }
  .versao {
    display: inline-block;
    margin: 1.25rem 0 0;
    padding: 0.2rem 0.75rem;
    border: 0;
    background: var(--cor-lima);
    border-radius: 999px;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--cor-tinta);
  }
  .versao[hidden] {
    display: none;
  }
  .bloco {
    border-radius: var(--raio-grande);
    background: var(--cor-fundo-elevado);
    padding: clamp(1.5rem, 3.5vw, 2.25rem);
    display: flex;
    flex-direction: column;
  }
  .principal {
    gap: 1.5rem;
    background: var(--cor-roxo);
    padding-block: clamp(2rem, 5vw, 3.25rem);
  }
  .principal .texto p {
    color: rgb(255 255 255 / 0.85);
  }
  .principal .pequeno a {
    color: rgb(255 255 255 / 0.85);
    text-decoration-color: rgb(255 255 255 / 0.4);
  }
  .principal .celular {
    background: rgb(0 0 0 / 0.22);
    border-color: transparent;
  }
  @media (min-width: 840px) {
    .principal {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: 3rem;
    }
    .principal .texto {
      max-width: 30rem;
    }
    .principal .acoes {
      flex-shrink: 0;
    }
  }
  .principal h2 {
    font-size: clamp(1.6rem, 3.4vw, 2.3rem);
  }
  .blocos {
    display: grid;
    gap: var(--vao);
    margin-top: var(--vao);
  }
  @media (min-width: 840px) {
    .blocos {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  h2 {
    font-size: 1.3rem;
    margin-bottom: 0.6rem;
  }
  .bloco p {
    color: var(--cor-texto-suave);
    margin-top: 0;
  }
  .botoes {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: auto;
  }
  .principal .botoes {
    margin-top: 0;
  }
  .pequeno {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.25rem;
    font-size: 0.9rem;
    margin: 1rem 0 0 !important;
  }
  .empurra {
    margin-top: auto !important;
  }
  .pequeno a {
    color: var(--cor-texto-suave);
    text-underline-offset: 3px;
    text-decoration-color: var(--cor-borda-forte);
  }
  .pequeno a:hover {
    color: var(--cor-texto);
    text-decoration-color: currentColor;
  }
  .celular {
    margin: 0 0 1rem !important;
    padding: 0.75rem 1rem;
    border-radius: var(--raio);
    background: rgb(255 255 255 / 0.04);
    border: 1px solid var(--cor-borda-forte);
    font-size: 0.92rem;
    color: var(--cor-texto) !important;
  }
  .celular[hidden] {
    display: none;
  }
  .primeira-vez {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 2rem;
    margin-top: var(--vao);
    padding: 1.5rem clamp(1.5rem, 3.5vw, 2.25rem);
    border: 1px dashed var(--cor-borda-forte);
    border-radius: var(--raio-grande);
  }
  .primeira-vez h2 {
    font-family: var(--fonte-texto);
    font-size: 1.05rem;
    font-weight: 600;
    margin-bottom: 0.2rem;
  }
  .primeira-vez p {
    color: var(--cor-texto-suave);
    margin: 0;
  }
  @media (max-width: 480px) {
    .principal .botoes {
      flex-direction: column;
    }
  }
</style>
