---
import Base from '../../layouts/Base.astro';
import { outroIdioma, rota, t, type Idioma } from '../../lib/i18n';
import { DOWNLOADS, HARDWARE } from '../../lib/site';
import { urlInstalar, urlMontagem } from '../../lib/links';

interface Props {
  idioma: Idioma;
}

const { idioma } = Astro.props;
---

<Base
  idioma={idioma}
  titulo={t(idioma, 'baixar_titulo')}
  descricao={t(idioma, 'baixar_descricao')}
  alternativa={rota(outroIdioma(idioma), 'baixar')}>
  <section class="conteiner pagina">
    <header class="cabeca">
      <h1>{t(idioma, 'baixar_h1')}</h1>
    </header>

    <!-- 1. O software: o download principal, em destaque. -->
    <article class="principal">
      <div class="texto">
        <h2>{t(idioma, 'baixar_software')}</h2>
        <p class="versao" data-versao data-rotulo={t(idioma, 'baixar_versao_atual')} hidden></p>
      </div>
      <div class="acoes">
        <p class="celular" data-celular hidden>{t(idioma, 'baixar_celular')}</p>
        <div class="botoes" data-sistemas>
          <div class="sistema" data-sistema="windows">
            <svg class="logo" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 5.5l7.5-1v7H3zM11.5 4.3L21 3v8.5h-9.5zM3 12.5h7.5v7L3 18.5zM11.5 12.5H21V21l-9.5-1.3z" /></svg>
            <a class="botao botao-grande baixar" href={DOWNLOADS.windows}>{t(idioma, 'baixar_windows')}</a>
          </div>
          <div class="sistema" data-sistema="linux">
            <svg class="logo" viewBox="0 0 512 512" aria-hidden="true"><g transform="translate(0,512) scale(0.05,-0.05)" stroke="none"><path d="M4970 8646 c-726 -162 -875 -479 -794 -1687 45 -666 49 -651 -358 -1199 -242 -326 -316 -467 -477 -910 -68 -187 -155 -408 -192 -491 -90 -201 -116 -328 -91 -440 19 -85 17 -92 -45 -159 -36 -38 -82 -97 -102 -130 -93 -155 -198 -226 -412 -279 -334 -83 -391 -170 -309 -471 35 -126 27 -200 -42 -431 -93 -313 -12 -384 544 -477 223 -38 393 -83 678 -179 643 -219 767 -222 961 -23 103 106 104 106 301 140 562 94 1369 44 1438 -90 156 -302 529 -323 859 -49 175 146 371 270 788 500 484 267 551 446 232 625 -214 120 -289 221 -289 388 0 119 -29 211 -101 325 l-62 97 32 184 c100 592 -35 940 -788 2016 -385 550 -397 586 -438 1294 -50 850 -308 1292 -834 1429 -109 29 -404 39 -499 17z m618 -973 c197 -151 199 -587 3 -692 -89 -48 -118 -13 -61 71 89 132 54 317 -70 368 -125 52 -230 -54 -227 -231 l1 -105 -57 20 c-78 27 -104 84 -104 226 1 321 290 514 515 343z m-933 -45 c147 -95 187 -420 61 -500 l-75 -48 12 60 c25 125 -69 280 -169 280 -152 0 -154 -344 -1 -408 l57 -25 -46 -43 c-156 -147 -304 342 -174 576 82 147 210 189 335 108z m565 -706 c440 -171 445 -197 75 -409 -322 -184 -405 -220 -470 -203 -122 30 -405 271 -405 344 0 28 222 220 360 310 112 73 156 69 440 -42z m505 -417 c130 -148 675 -1457 769 -1847 42 -177 47 -624 8 -803 l-25 -115 -96 0 c-189 0 -216 -69 -219 -560 l-2 -251 -64 -77 c-272 -331 -641 -485 -1208 -507 -386 -14 -378 -17 -546 180 l-141 165 71 36 c95 49 140 153 111 253 -26 86 -117 176 -427 425 -381 307 -436 397 -436 716 0 231 48 417 172 675 60 123 141 317 181 430 112 323 156 420 252 561 116 169 202 404 204 554 l1 113 138 -119 c262 -225 347 -238 621 -94 105 55 277 145 382 200 216 113 212 112 254 65z m-2417 -2904 c90 -56 192 -186 348 -444 210 -348 281 -455 400 -607 197 -251 231 -395 129 -545 -151 -223 -273 -224 -830 -7 -283 111 -279 110 -630 172 -413 74 -427 89 -344 384 43 153 45 255 7 440 -20 101 45 149 277 204 225 53 277 87 348 229 113 224 165 255 295 174z m3212 -177 c0 -417 570 -465 821 -70 l56 89 29 -46 c16 -26 39 -114 51 -196 26 -182 90 -283 233 -366 280 -163 269 -190 -160 -416 -316 -165 -426 -236 -567 -366 -500 -460 -775 -256 -641 474 58 315 62 367 52 633 -11 313 -1 360 77 360 45 0 49 -7 49 -96z"/></g></svg>
            <a class="botao botao-grande baixar" href={DOWNLOADS.linux}>{t(idioma, 'baixar_linux')}</a>
          </div>
        </div>
        <p class="apoio">
          <a href={urlInstalar(idioma)}>{t(idioma, 'baixar_como_instalar')}</a>
          <a href={DOWNLOADS.sha256}>{t(idioma, 'baixar_sha')}</a>
        </p>
      </div>
    </article>

    <!-- 2. O que precisa para montar: case, placa e firmware, cada um com seus arquivos. -->
    <h2 class="grupo">{t(idioma, 'baixar_montar_titulo')}</h2>
    <div class="cartoes">
      <article class="cartao">
        <h3>{t(idioma, 'baixar_hardware')}</h3>
        <ul class="arquivos">
          <li>
            <a href={HARDWARE.caseTopo}>
              <span>{t(idioma, 'baixar_case_topo')}</span>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 4v12M7 11l5 5 5-5M5 20h14" /></svg>
            </a>
          </li>
          <li>
            <a href={HARDWARE.caseBase}>
              <span>{t(idioma, 'baixar_case_base')}</span>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 4v12M7 11l5 5 5-5M5 20h14" /></svg>
            </a>
          </li>
          <li>
            <a href={HARDWARE.gcode}>
              <span>{t(idioma, 'baixar_gcode')}</span>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 4v12M7 11l5 5 5-5M5 20h14" /></svg>
            </a>
          </li>
        </ul>
      </article>

      <article class="cartao">
        <h3>{t(idioma, 'baixar_placa')}</h3>
        <p>{t(idioma, 'baixar_placa_texto')}</p>
        <ul class="arquivos">
          <li>
            <a href={HARDWARE.placa}>
              <span>{t(idioma, 'baixar_placa_link')}</span>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 17L17 7M9 7h8v8" /></svg>
            </a>
          </li>
        </ul>
      </article>

      <article class="cartao">
        <h3>{t(idioma, 'baixar_firmware')}</h3>
        <p>{t(idioma, 'baixar_firmware_texto')}</p>
        <ul class="arquivos">
          <li>
            <a data-firmware href={DOWNLOADS.firmwareReserva}>
              <span>{t(idioma, 'baixar_firmware_avancado')}</span>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 4v12M7 11l5 5 5-5M5 20h14" /></svg>
            </a>
          </li>
        </ul>
      </article>
    </div>

    <!-- 3. Quem nunca montou: o caminho para o guia. -->
    <aside class="primeira-vez">
      <div>
        <h2>{t(idioma, 'baixar_primeira_vez')}</h2>
      </div>
      <a class="botao botao-secundario" href={urlMontagem(idioma)}>
        {t(idioma, 'baixar_primeira_vez_link')}
      </a>
    </aside>
  </section>
</Base>

<script>
  import '../../scripts/versao';

  // Quem está no Linux vê o botão do Linux primeiro. Na dúvida, fica o do Windows na frente.
  const ua = navigator.userAgent;
  const linux = /Linux|X11/.test(ua) && !/Android/.test(ua);
  // No celular o instalador não serve: avisa antes dos botões.
  if (/Android|iPhone|iPad|iPod/.test(ua)) {
    const aviso = document.querySelector<HTMLElement>('[data-celular]');
    if (aviso) aviso.hidden = false;
  }
  if (linux) {
    const caixa = document.querySelector<HTMLElement>('[data-sistemas]');
    const win = caixa?.querySelector<HTMLElement>('[data-sistema="windows"]');
    const lin = caixa?.querySelector<HTMLElement>('[data-sistema="linux"]');
    if (caixa && win && lin) {
      caixa.prepend(lin);
    }
  }
</script>

<style>
  .pagina {
    padding-block: clamp(2.5rem, 9vw, 7rem) 0;
  }

  /* Título grande, como o da página de Docs. */
  .cabeca {
    margin-bottom: clamp(2.5rem, 6vw, 4rem);
  }
  h1 {
    margin: 0 0 1.25rem;
    font-size: clamp(2.4rem, 11vw, 9rem);
    line-height: 0.85;
    letter-spacing: -0.05em;
  }
  /* A versão atual, em texto simples, logo abaixo do título do bloco. */
  .versao {
    margin: 0.6rem 0 0;
    font-size: 1rem;
    font-weight: 600;
    color: rgb(255 255 255 / 0.9);
  }
  .versao[hidden] {
    display: none;
  }

  /* 1. O software, em destaque: um bloco roxo largo, texto à esquerda e botões à direita. */
  .principal {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    padding: clamp(1.1rem, 2.5vw, 1.6rem) clamp(1.75rem, 4vw, 2.75rem);
    border-radius: 6px;
    background: var(--cor-roxo);
    color: var(--cor-texto);
  }
  .principal h2 {
    margin: 0;
    font-size: clamp(1.6rem, 3.4vw, 2.3rem);
    letter-spacing: -0.03em;
  }
  /* Cada sistema: o logo em cima, fora do botão, e o botão branco embaixo. */
  .sistema {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.9rem;
  }
  .logo {
    width: 4.5rem;
    height: 4.5rem;
    fill: var(--cor-texto);
  }
  .baixar {
    background: var(--cor-texto);
    color: var(--cor-tinta);
    border-color: var(--cor-texto);
  }
  .baixar:hover {
    background: var(--cor-papel);
  }
  .botoes {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: 1.5rem;
  }
  .apoio {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.4rem 1.5rem;
    margin: 1.1rem 0 0;
    font-size: 0.95rem;
  }
  .apoio a {
    color: rgb(255 255 255 / 0.9);
    text-underline-offset: 3px;
    text-decoration-color: rgb(255 255 255 / 0.4);
  }
  .apoio a:hover {
    color: var(--cor-texto);
    text-decoration-color: currentColor;
  }
  .celular {
    margin: 0 0 1rem;
    padding: 0.75rem 1rem;
    border-radius: 6px;
    background: rgb(0 0 0 / 0.22);
    font-size: 0.92rem;
  }
  .celular[hidden] {
    display: none;
  }
  @media (min-width: 840px) {
    .principal {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: 3rem;
    }
    .principal .acoes {
      flex-shrink: 0;
    }
  }

  /* 2. Para montar: três cartões iguais, cada um com a descrição e a lista dos arquivos. */
  .grupo {
    margin: clamp(3.5rem, 8vw, 5.5rem) 0 1.5rem;
    font-size: clamp(1.5rem, 3vw, 2rem);
    letter-spacing: -0.03em;
  }
  .cartoes {
    display: grid;
    gap: calc(var(--vao) * 1.5);
  }
  @media (min-width: 840px) {
    .cartoes {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .cartao {
    display: flex;
    flex-direction: column;
    padding: clamp(1.5rem, 3vw, 2rem);
    border-radius: 10px;
    box-shadow: inset 0 0 0 1px var(--cor-borda-forte);
  }
  .cartao h3 {
    margin: 0 0 0.6rem;
    font-size: 1.35rem;
    letter-spacing: -0.03em;
  }
  .cartao p {
    margin: 0 0 1.75rem;
    color: var(--cor-texto-suave);
    line-height: 1.6;
  }
  /* Sem descrição (o cartão do case), a lista fica a uma distância de respiro do título. */
  .cartao h3 + .arquivos {
    margin-top: 1.75rem;
  }
  /* Os arquivos viram linhas clicáveis, coladas no pé do cartão. */
  .arquivos {
    display: flex;
    flex-direction: column;
    margin: auto 0 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--cor-borda);
  }
  .arquivos li {
    border-bottom: 1px solid var(--cor-borda);
  }
  .arquivos a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.85rem 0.15rem;
    color: var(--cor-texto);
    font-weight: 600;
    text-decoration: none;
    transition: color 0.15s;
  }
  .arquivos a:hover {
    color: var(--cor-lima);
  }
  .arquivos svg {
    flex-shrink: 0;
    width: 1.15rem;
    height: 1.15rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* 3. Primeira vez: uma faixa fina no fim, com o caminho para o guia. */
  .primeira-vez {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem 2rem;
    margin-top: clamp(2.5rem, 6vw, 4rem);
    padding: clamp(1.25rem, 3vw, 1.75rem) clamp(1.5rem, 3vw, 2rem);
    border-radius: 6px;
    background: var(--cor-roxo);
    color: var(--cor-texto);
  }
  .primeira-vez h2 {
    margin: 0;
    font-size: 1.25rem;
    letter-spacing: -0.03em;
  }
  .primeira-vez .botao {
    border-color: rgb(255 255 255 / 0.6);
  }
  /* Ao passar o mouse, o botão fica branco, com as letras roxas. */
  .primeira-vez .botao:hover {
    background: var(--cor-texto);
    border-color: var(--cor-texto);
    color: var(--cor-roxo);
  }
  /* No celular, os dois sistemas um embaixo do outro, cada um com o logo em cima e o botão
     na largura toda; os links de apoio voltam para a esquerda. */
  @media (max-width: 839px) {
    .botoes {
      flex-direction: column;
      align-items: stretch;
      gap: 1.75rem;
    }
    .sistema .baixar {
      width: 100%;
    }
    .apoio {
      justify-content: flex-start;
    }
    .logo {
      width: 3.5rem;
      height: 3.5rem;
    }
    .primeira-vez .botao {
      width: 100%;
    }
  }
</style>
