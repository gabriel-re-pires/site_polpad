---
// Índice dos docs: os guias são uma sequência (montar, instalar, firmware, enviar),
// então aparecem como um mosaico numerado, cada um com as
// seções que tem dentro, com link direto para elas.
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { outroIdioma, rota, t, type Idioma } from '../../lib/i18n';
import { corDoGuia, docsDoIdioma, urlDoc } from '../../lib/docs';
import { REPO_POLPAD } from '../../lib/site';

interface Props {
  idioma: Idioma;
}

const { idioma } = Astro.props;
const lista = docsDoIdioma(await getCollection('docs'), idioma);
const guias = lista.map((doc, i) => ({
  doc,
  numero: String(i + 1).padStart(2, '0'),
  // Uma cor por guia (roxo, claro, claro e claro), a mesma do topo da página dele.
  cor: corDoGuia(i),
}));
---

<Base
  idioma={idioma}
  titulo={t(idioma, 'docs_titulo')}
  descricao={t(idioma, 'docs_descricao')}
  alternativa={rota(outroIdioma(idioma), 'docs')}>
  <div class="conteiner pagina">
    <header class="topo">
      <h1>{t(idioma, 'docs_titulo')}</h1>
    </header>

    <ol class="guias">
      {
        guias.map((g) => (
          <li class:list={['guia', g.cor]} style={`view-transition-name: guia-${g.doc.data.chave}`}>
            <div class="cabeca">
              <span class="visor" aria-hidden="true">
                {g.numero}
              </span>
            </div>
            <h2>
              <a class="principal" href={urlDoc(idioma, g.doc)}>
                {g.doc.data.titulo}
              </a>
            </h2>
            <a class="abrir" href={urlDoc(idioma, g.doc)} tabindex="-1" aria-hidden="true">
              {t(idioma, 'docs_abrir')}
            </a>
          </li>
        ))
      }
    </ol>

    <aside class="ajuda">
      <div>
        <h2>{t(idioma, 'docs_ajuda_titulo')}</h2>
        <p>{t(idioma, 'docs_ajuda_texto')}</p>
      </div>
      <a class="botao issue" href={`${REPO_POLPAD}/issues/new`}>{t(idioma, 'docs_ajuda_issue')}</a>
    </aside>
  </div>
</Base>

<style>
  .pagina {
    padding-block: clamp(2.5rem, 6vw, 4.5rem) 0;
  }

  /* Só o título, enorme, em cima do mosaico. */
  .topo {
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }
  h1 {
    margin: 0;
    font-size: clamp(2.4rem, 11vw, 9rem);
    line-height: 0.85;
    letter-spacing: -0.05em;
  }

  /* Mosaico dos guias: dois por linha, cada um de uma cor, com o botão de abrir
     passando da borda de baixo. O cartão inteiro é clicável. */
  .guias {
    display: grid;
    gap: 2.75rem var(--vao);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  @media (min-width: 760px) {
    .guias {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  .guia {
    position: relative;
    display: flex;
    flex-direction: column;
    min-height: 12.5rem;
    padding: clamp(1.4rem, 3vw, 2rem) clamp(1.4rem, 3vw, 2rem) 5rem;
    border-radius: var(--raio-grande);
    transition: translate 0.25s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .guia:hover,
  .guia:focus-within {
    translate: 0 -4px;
  }
  /* O número do guia, no alto do cartão, em cima do título. */
  .cabeca {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding-bottom: 2.25rem;
  }
  /* O número num "display" preto com fonte de pixel, como o OLED do Polpad One. */
  .visor {
    padding: 0.5rem 0.7rem 0.4rem;
    border-radius: 8px;
    background: #000;
    box-shadow: 0 0 0 3px rgb(255 255 255 / 0.08);
    color: #fff;
    font-family: var(--fonte-pixel);
    font-size: 1.05rem;
    line-height: 1;
  }
  /* Um cursor de pixel, escondido, que pisca quando o cartão está sob o mouse ou o foco.
     O espaço dele fica sempre reservado, para o número não pular. */
  .visor::after {
    content: '_';
    opacity: 0;
  }
  .guia:is(:hover, :focus-within) .visor::after {
    animation: cursor 1s steps(1) infinite;
  }
  @keyframes cursor {
    0% {
      opacity: 1;
    }
    50% {
      opacity: 0;
    }
  }
  h2 {
    margin: 0 0 1.5rem;
    font-size: clamp(1.6rem, 3.2vw, 2.25rem);
    letter-spacing: -0.03em;
  }
  .principal {
    color: inherit;
    text-decoration: none;
  }
  /* O link do título cobre o cartão; os links das seções ficam por cima dele. */
  .principal::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }
  .principal:focus-visible {
    outline: none;
  }
  .guia:has(.principal:focus-visible) {
    outline: 3px solid var(--cor-lima);
    outline-offset: 4px;
  }
  /* "Abrir o guia": um botão verde dentro do cartão, no canto direito de baixo. É um link
     de verdade (fica por cima do link que cobre o cartão) e não muda de cor com o cartão. */
  .abrir {
    position: absolute;
    z-index: 1;
    right: clamp(1.4rem, 3vw, 2rem);
    bottom: clamp(1.4rem, 3vw, 2rem);
    padding: 0.6rem 1.25rem;
    border-radius: 15px;
    background: var(--cor-lima);
    color: var(--cor-tinta);
    font-weight: 600;
    text-decoration: none;
    cursor: pointer;
    transition:
      background-color 0.15s,
      transform 0.15s;
  }
  .abrir:hover {
    background: var(--cor-lima-forte);
    transform: translateY(-1px);
  }

  .roxo {
    background: var(--cor-roxo);
    color: var(--cor-texto);
  }
  .claro {
    background: var(--cor-papel-claro);
    color: var(--cor-tinta);
  }

  /* Ajuda: uma faixa larga no fim, para quem travou. */
  .ajuda {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 2rem;
    margin-top: clamp(3rem, 6vw, 4rem);
    padding: clamp(1rem, 2.5vw, 1.4rem) clamp(1.25rem, 3vw, 1.75rem);
    border-radius: 10px;
    box-shadow: inset 0 0 0 1px var(--cor-borda-forte);
  }
  .ajuda h2 {
    margin-bottom: 0.2rem;
    font-size: clamp(1.1rem, 2vw, 1.35rem);
  }
  .ajuda > div:first-child {
    flex: 1 1 26rem;
  }
  .ajuda p {
    max-width: 44rem;
    margin: 0;
    color: var(--cor-texto-suave);
    font-size: 0.9rem;
  }
  /* O botão de abrir a issue, em roxo. */
  .issue {
    background: var(--cor-roxo);
    color: var(--cor-texto);
  }
  .issue:hover {
    background: color-mix(in srgb, var(--cor-roxo) 82%, #fff);
  }

  @media (prefers-reduced-motion: reduce) {
    .guia:hover,
    .guia:focus-within {
      translate: none;
    }
  }
  /* No celular, um guia embaixo do outro: cartões mais baixos e mais perto uns dos outros. */
  @media (max-width: 759px) {
    .guias {
      gap: 1rem;
    }
    .guia {
      min-height: 0;
    }
    .cabeca {
      padding-bottom: 1.25rem;
    }
  }
</style>
