---
import { getCollection } from 'astro:content';
import DocsLayout from '../../layouts/Docs.astro';
import { outroIdioma, rota, t, type Idioma } from '../../lib/i18n';
import { docsDoIdioma, urlDoc } from '../../lib/docs';

interface Props {
  idioma: Idioma;
}

const { idioma } = Astro.props;
const lista = docsDoIdioma(await getCollection('docs'), idioma);
---

<DocsLayout idioma={idioma} titulo={t(idioma, 'docs_titulo')} alternativa={rota(outroIdioma(idioma), 'docs')}>
  <h1>{t(idioma, 'docs_titulo')}</h1>
  <p class="intro">{t(idioma, 'docs_intro')}</p>
  <ul class="lista">
    {
      lista.map((doc) => (
        <li>
          <a href={urlDoc(idioma, doc)}>
            <strong>{doc.data.titulo}</strong>
            <span>{doc.data.descricao}</span>
          </a>
        </li>
      ))
    }
  </ul>
</DocsLayout>

<style>
  .intro {
    color: var(--cor-texto-suave);
  }
  .lista {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 1rem;
  }
  .lista a {
    display: block;
    border: 1px solid var(--cor-borda);
    border-radius: var(--raio);
    background: var(--cor-fundo-elevado);
    padding: 1rem 1.25rem;
    text-decoration: none;
  }
  .lista a:hover {
    border-color: var(--cor-destaque);
  }
  .lista strong {
    display: block;
    margin-bottom: 0.2rem;
  }
  .lista span {
    color: var(--cor-texto-suave);
    font-size: 0.95rem;
  }
</style>
