---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { outroIdioma, rota, t, type Idioma } from '../../lib/i18n';
import { urlArquivo } from '../../lib/comunidade';
import { urlEnviarProjeto } from '../../lib/links';
import { dataPorExtenso, paragrafos, resumo } from '../../lib/formato';

interface Props {
  idioma: Idioma;
  projeto: CollectionEntry<'comunidade'>;
}

const { idioma, projeto } = Astro.props;
const { titulo, tipo, autor, descricao, licenca, data, capa, fotos, arquivos, links, versao_firmware, oficial } = projeto.data;
const semArquivos = arquivos.length === 0 && links.length === 0;
const nomeArquivo = (caminho: string) => caminho.split('/').pop() ?? caminho;
// Só o domínio do link, para dizer para onde ele leva.
const dominio = (url: string) => new URL(url).hostname.replace(/^www\./, '');
---

<Base
  idioma={idioma}
  titulo={titulo}
  descricao={resumo(paragrafos(descricao)[0] ?? titulo, 160)}
  alternativa={rota(outroIdioma(idioma), 'comunidade', projeto.id)}
>
  <article class="conteiner pagina">
    <a class="voltar" href={rota(idioma, 'comunidade')}>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M19 12H5M11 6l-6 6 6 6" /></svg>
      {t(idioma, 'projeto_voltar')}
    </a>

    <!-- Abertura: a capa de um lado; do outro, o tipo, o título, o autor e os dados. -->
    <header class="cabeca">
      <div class="moldura" style={`view-transition-name: projeto-${projeto.id}`}>
        <Image src={capa} alt={titulo} widths={[480, 960]} sizes="(min-width: 960px) 520px, 100vw" class="capa" />
      </div>
      <div class="dados">
        <span class="tipo">{t(idioma, `tipo_${tipo}`)}</span>
        <h1>{titulo}</h1>
        {
          !oficial && (
            <p class="autor">
              {`${t(idioma, 'projeto_por')} `}
              {autor.github ? <a href={`https://github.com/${autor.github}`}>{autor.nome}</a> : autor.nome}
            </p>
          )
        }
        <dl>
          <div>
            <dt>{t(idioma, 'projeto_licenca')}</dt>
            <dd><a href={`https://spdx.org/licenses/${licenca}.html`}>{licenca}</a></dd>
          </div>
          <div>
            <dt>{t(idioma, 'projeto_data')}</dt>
            <dd><time datetime={data.toISOString().slice(0, 10)}>{dataPorExtenso(data, idioma)}</time></dd>
          </div>
          {
            versao_firmware && (
              <div>
                <dt>{t(idioma, 'projeto_firmware')}</dt>
                <dd>{versao_firmware}</dd>
              </div>
            )
          }
        </dl>
      </div>
    </header>

    <div class="descricao">
      {paragrafos(descricao).map((p) => <p>{p}</p>)}
    </div>

    {
      arquivos.length > 0 && (
        <section>
          <h2>{t(idioma, 'projeto_arquivos')}</h2>
          <ul class="lista">
            {arquivos.map((arquivo) => (
              <li>
                <a href={urlArquivo(projeto.id, arquivo)} download>
                  <span>{nomeArquivo(arquivo)}</span>
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 4v12M7 11l5 5 5-5M5 20h14" /></svg>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      links.length > 0 && (
        <section>
          <h2>{t(idioma, 'projeto_links')}</h2>
          <ul class="lista">
            {links.map((link) => (
              <li>
                <a href={link.url} rel="noopener">
                  <span>
                    {link.titulo}
                    <small>{dominio(link.url)}</small>
                  </span>
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 17L17 7M9 7h8v8" /></svg>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {semArquivos && <p class="sem-arquivos">{t(idioma, 'projeto_sem_arquivos')}</p>}

    {
      fotos.length > 0 && (
        <section>
          <h2>{t(idioma, 'projeto_fotos')}</h2>
          <div class="fotos">
            {fotos.map((foto, i) => (
              <Image src={foto} alt={`${titulo} (${i + 1})`} widths={[480, 960]} sizes="(min-width: 960px) 540px, 100vw" />
            ))}
          </div>
        </section>
      )
    }

    <!-- Convite no fim: uma faixa roxa com o botão para enviar o seu. -->
    <aside class="convite">
      <p>{t(idioma, 'projeto_convite')}</p>
      <a class="botao" href={urlEnviarProjeto(idioma)}>{t(idioma, 'comunidade_enviar')}</a>
    </aside>
  </article>
</Base>

<style>
  .pagina {
    padding-block: clamp(2.5rem, 9vw, 7rem) 0;
  }

  /* Voltar: um link simples, com a seta para a esquerda. */
  .voltar {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--cor-texto-suave);
    text-decoration: none;
    font-weight: 600;
    font-size: 0.95rem;
    transition: color 0.15s;
  }
  .voltar:hover {
    color: var(--cor-texto);
  }
  .voltar svg {
    width: 1.1rem;
    height: 1.1rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* Abertura: a capa à esquerda; à direita o tipo, o título, o autor e os dados. */
  .cabeca {
    display: grid;
    gap: 2rem clamp(2.5rem, 5vw, 4rem);
    margin-block: clamp(2rem, 4vw, 3rem) clamp(3rem, 6vw, 4.5rem);
  }
  @media (min-width: 840px) {
    .cabeca {
      grid-template-columns: minmax(0, 520px) 1fr;
      align-items: center;
    }
  }
  .capa {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 10px;
  }
  .tipo {
    display: inline-block;
    margin-bottom: 1rem;
    padding: 0.25rem 0.75rem;
    border-radius: 4px;
    background: var(--cor-roxo);
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--cor-texto);
  }
  h1 {
    margin: 0 0 1.25rem;
    font-size: clamp(2.4rem, 6vw, 4.5rem);
    line-height: 0.95;
    letter-spacing: -0.045em;
  }
  h1 + dl {
    margin-top: 0.5rem;
  }
  .autor {
    margin: 0 0 1.75rem;
    color: var(--cor-texto-suave);
  }
  .autor a {
    color: var(--cor-texto);
    text-underline-offset: 3px;
  }
  /* Licença, data e versão em pequenos blocos de contorno fino, lado a lado. */
  dl {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin: 0;
  }
  dl > div {
    padding: 0.55rem 0.9rem;
    border-radius: 6px;
    box-shadow: inset 0 0 0 1px var(--cor-borda-forte);
  }
  dt {
    font-size: 0.78rem;
    color: var(--cor-texto-suave);
  }
  dd {
    margin: 0.1rem 0 0;
    font-size: 0.95rem;
    font-weight: 600;
  }
  dd a {
    color: var(--cor-texto);
    text-underline-offset: 3px;
  }

  /* O texto no mesmo padrão das outras páginas: largura toda, justificado. */
  .descricao p {
    margin: 0 0 1.5rem;
    color: var(--cor-texto-corpo);
    font-size: clamp(1.02rem, 1.8vw, 1.2rem);
    line-height: 1.75;
    text-align: var(--alinhar-texto);
    hyphens: auto;
  }
  section {
    margin-top: clamp(3rem, 6vw, 4.5rem);
  }
  h2 {
    margin: 0 0 1.25rem;
    font-size: clamp(1.5rem, 3vw, 2rem);
    letter-spacing: -0.03em;
  }

  /* Arquivos e links: linhas clicáveis, como nos cartões da página de Download. */
  .lista {
    display: flex;
    flex-direction: column;
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--cor-borda-forte);
  }
  .lista li {
    border-bottom: 1px solid var(--cor-borda-forte);
  }
  .lista a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem 0.25rem;
    color: var(--cor-texto);
    font-weight: 600;
    text-decoration: none;
    transition: color 0.15s;
  }
  .lista a:hover {
    color: var(--cor-lima);
  }
  .lista small {
    display: block;
    margin-top: 0.15rem;
    color: var(--cor-texto-suave);
    font-size: 0.85rem;
    font-weight: 400;
  }
  .lista svg {
    flex-shrink: 0;
    width: 1.25rem;
    height: 1.25rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .sem-arquivos {
    margin-top: clamp(3rem, 6vw, 4.5rem);
    color: var(--cor-texto-suave);
  }
  .fotos {
    display: grid;
    gap: calc(var(--vao) * 1.5);
  }
  @media (min-width: 640px) {
    .fotos {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  .fotos :global(img) {
    border-radius: 10px;
    width: 100%;
  }

  /* Convite no fim: uma faixa roxa, no mesmo estilo de "Primeira vez?" na página de Download. */
  .convite {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem 2rem;
    margin-top: clamp(3.5rem, 8vw, 5.5rem);
    padding: clamp(1.25rem, 3vw, 1.75rem) clamp(1.5rem, 3vw, 2rem);
    border-radius: 6px;
    background: var(--cor-roxo);
    color: var(--cor-texto);
  }
  .convite p {
    margin: 0;
    max-width: 44ch;
    font-size: 1.1rem;
    font-weight: 600;
  }
  .convite .botao {
    border-color: rgb(255 255 255 / 0.6);
    color: var(--cor-texto);
  }
  /* Ao passar o mouse, o botão fica branco, com as letras roxas. */
  .convite .botao:hover {
    background: var(--cor-texto);
    border-color: var(--cor-texto);
    color: var(--cor-roxo);
  }
</style>
