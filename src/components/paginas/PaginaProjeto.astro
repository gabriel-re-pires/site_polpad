---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { outroIdioma, rota, t, type Idioma } from '../../lib/i18n';
import { urlArquivo } from '../../lib/comunidade';
import { urlEnviarProjeto } from '../../lib/links';
import { dataPorExtenso, paragrafos, resumo } from '../../lib/formato';

interface Props {
  idioma: Idioma;
  projeto: CollectionEntry<'comunidade'>;
}

const { idioma, projeto } = Astro.props;
const { titulo, tipo, autor, descricao, licenca, data, capa, fotos, arquivos, links, versao_firmware } = projeto.data;
const semArquivos = arquivos.length === 0 && links.length === 0;
const nomeArquivo = (caminho: string) => caminho.split('/').pop() ?? caminho;
// Só o domínio do link, para dizer para onde ele leva.
const dominio = (url: string) => new URL(url).hostname.replace(/^www\./, '');
// Iniciais do autor, no lugar de uma foto (a página não carrega imagens de fora).
const iniciais = autor.nome
  .split(/\s+/)
  .filter((parte) => /^\p{Lu}/u.test(parte))
  .slice(0, 2)
  .map((parte) => parte[0])
  .join('');
---

<Base
  idioma={idioma}
  titulo={titulo}
  descricao={resumo(paragrafos(descricao)[0] ?? titulo, 160)}
  alternativa={rota(outroIdioma(idioma), 'comunidade', projeto.id)}
>
  <article class="conteiner">
    <a class="voltar" href={rota(idioma, 'comunidade')}>{t(idioma, 'projeto_voltar')}</a>

    <div class="cabeca">
      <div class="moldura" style={`view-transition-name: projeto-${projeto.id}`}>
        <Image src={capa} alt={titulo} widths={[480, 960]} sizes="(min-width: 960px) 480px, 100vw" class="capa" />
        <span class="tipo">{t(idioma, `tipo_${tipo}`)}</span>
      </div>
      <div class="dados">
        <h1>{titulo}</h1>
        <p class="autor">
          <span class="iniciais" aria-hidden="true">{iniciais || autor.nome[0]}</span>
          <span>
            {`${t(idioma, 'projeto_por')} `}{
              autor.github ? <a href={`https://github.com/${autor.github}`}>{autor.nome}</a> : autor.nome
            }
          </span>
        </p>
        <dl>
          <div>
            <dt>{t(idioma, 'projeto_licenca')}</dt>
            <dd><a href={`https://spdx.org/licenses/${licenca}.html`}>{licenca}</a></dd>
          </div>
          <div>
            <dt>{t(idioma, 'projeto_data')}</dt>
            <dd><time datetime={data.toISOString().slice(0, 10)}>{dataPorExtenso(data, idioma)}</time></dd>
          </div>
          {
            versao_firmware && (
              <div>
                <dt>{t(idioma, 'projeto_firmware')}</dt>
                <dd>{versao_firmware}</dd>
              </div>
            )
          }
        </dl>
      </div>
    </div>

    <div class="descricao">
      {paragrafos(descricao).map((p) => <p>{p}</p>)}
    </div>

    {
      arquivos.length > 0 && (
        <section>
          <h2>{t(idioma, 'projeto_arquivos')}</h2>
          <ul class="botoes">
            {arquivos.map((arquivo) => (
              <li>
                <a class="botao botao-primario" href={urlArquivo(projeto.id, arquivo)} download>
                  {nomeArquivo(arquivo)}
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      links.length > 0 && (
        <section>
          <h2>{t(idioma, 'projeto_links')}</h2>
          <ul class="links">
            {links.map((link) => (
              <li>
                <a href={link.url} rel="noopener">
                  <strong>{link.titulo}</strong>
                  <span>{dominio(link.url)}</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {semArquivos && <p class="sem-arquivos">{t(idioma, 'projeto_sem_arquivos')}</p>}

    {
      fotos.length > 0 && (
        <section>
          <h2>{t(idioma, 'projeto_fotos')}</h2>
          <div class="fotos">
            {fotos.map((foto, i) => (
              <Image src={foto} alt={`${titulo} (${i + 1})`} widths={[480, 960]} sizes="(min-width: 960px) 540px, 100vw" />
            ))}
          </div>
        </section>
      )
    }
    <aside class="convite">
      <p>{t(idioma, 'projeto_convite')}</p>
      <a class="botao botao-escuro" href={urlEnviarProjeto(idioma)}>{t(idioma, 'comunidade_enviar')}</a>
    </aside>
  </article>
</Base>

<style>
  article {
    padding-block: clamp(1.5rem, 4vw, 2.5rem) 3rem;
  }
  .voltar {
    display: inline-block;
    padding: 0.4rem 0.95rem;
    border-radius: 999px;
    box-shadow: inset 0 0 0 1px var(--cor-borda-forte);
    color: var(--cor-texto-suave);
    text-decoration: none;
    font-weight: 600;
    font-size: 0.9rem;
    transition:
      color 0.15s,
      box-shadow 0.15s;
  }
  .voltar:hover {
    color: var(--cor-texto);
    box-shadow: inset 0 0 0 1px var(--cor-texto-suave);
  }

  /* Abertura num painel: a capa com respiro e a pílula do tipo sobre a borda dela. */
  .cabeca {
    --respiro: clamp(0.6rem, 1.5vw, 1rem);
    display: grid;
    gap: 2rem 3rem;
    margin-block: 1.25rem 2.5rem;
    padding: var(--respiro);
    border-radius: var(--raio-painel);
    background: var(--cor-fundo-elevado);
    box-shadow: inset 0 0 0 1px var(--cor-borda);
  }
  @media (min-width: 840px) {
    .cabeca {
      grid-template-columns: minmax(0, 480px) 1fr;
      align-items: center;
    }
  }
  .moldura {
    position: relative;
  }
  .capa {
    display: block;
    width: 100%;
    height: auto;
    border-radius: calc(var(--raio-painel) - var(--respiro));
  }
  .tipo {
    position: absolute;
    left: 1.25rem;
    bottom: 0;
    translate: 0 50%;
    padding: 0.3rem 0.9rem;
    border-radius: 999px;
    background: var(--cor-lima);
    box-shadow: 0 0 0 5px var(--cor-fundo-elevado);
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--cor-tinta);
  }
  .dados {
    padding: 1rem clamp(0.5rem, 2vw, 1.5rem) clamp(1rem, 2vw, 1.5rem);
  }
  h1 {
    margin: 0 0 1rem;
    font-size: clamp(1.9rem, 4.5vw, 3rem);
    letter-spacing: -0.035em;
  }
  h2 {
    font-size: 1.25rem;
    margin-top: 2.25rem;
  }
  .autor {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    margin: 0 0 1.25rem;
    color: var(--cor-texto-suave);
  }
  .autor a {
    color: var(--cor-texto);
    text-decoration-color: var(--cor-lima);
    text-underline-offset: 3px;
  }
  .iniciais {
    display: grid;
    place-items: center;
    width: 2.3rem;
    height: 2.3rem;
    border-radius: 50%;
    background: var(--cor-roxo);
    color: var(--cor-texto);
    font-family: var(--fonte-titulo);
    font-size: 0.8rem;
    font-weight: 600;
  }
  /* Licença, data e versão em pequenos blocos lado a lado. */
  dl {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
  }
  dl > div {
    padding: 0.5rem 0.85rem;
    border-radius: 14px;
    background: var(--cor-fundo);
    box-shadow: inset 0 0 0 1px var(--cor-borda);
  }
  dt {
    font-size: 0.78rem;
    color: var(--cor-texto-suave);
  }
  dd {
    margin: 0.1rem 0 0;
    font-size: 0.92rem;
    font-weight: 600;
  }
  dd a {
    color: var(--cor-texto);
    text-decoration-color: var(--cor-lima);
    text-underline-offset: 3px;
  }
  .descricao {
    max-width: 68ch;
    font-size: 1.05rem;
    color: var(--cor-texto-corpo);
  }
  .botoes {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    padding: 0;
    margin: 0;
    list-style: none;
  }
  /* Links como cartões: o nome e o site para onde ele leva. */
  .links {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 16rem), 1fr));
    gap: var(--vao);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .links a {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    height: 100%;
    padding: 1rem 1.2rem;
    border-radius: var(--raio-grande);
    background: var(--cor-fundo-elevado);
    box-shadow: inset 0 0 0 1px var(--cor-borda);
    text-decoration: none;
    transition:
      translate 0.25s cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow 0.2s;
  }
  .links a:hover {
    translate: 0 -3px;
    box-shadow: inset 0 0 0 1px var(--cor-lima);
  }
  .links strong {
    color: var(--cor-texto);
  }
  .links span {
    color: var(--cor-texto-suave);
    font-size: 0.85rem;
  }
  .sem-arquivos {
    color: var(--cor-texto-suave);
  }
  .fotos {
    display: grid;
    gap: 1rem;
  }
  @media (min-width: 640px) {
    .fotos {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  .fotos :global(img) {
    border-radius: var(--raio-grande);
    width: 100%;
  }
  /* Convite em limão, com borda e sombra chapadas, como na página da comunidade. */
  .convite {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 2rem;
    margin-top: 3.5rem;
    padding: 1.5rem clamp(1.25rem, 3vw, 2rem);
    border: 2.5px solid var(--cor-tinta);
    border-radius: var(--raio-grande);
    background: var(--cor-lima);
    color: var(--cor-tinta);
    box-shadow: 0.45rem 0.45rem 0 var(--cor-roxo);
  }
  .convite p {
    margin: 0;
    max-width: 44ch;
    font-weight: 600;
  }
  @media (prefers-reduced-motion: reduce) {
    .links a:hover {
      translate: none;
    }
  }
</style>
