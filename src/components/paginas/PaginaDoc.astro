---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import DocsLayout from '../../layouts/Docs.astro';
import { outroIdioma, rota, t, type Idioma } from '../../lib/i18n';
import { docsDoIdioma, traducao, urlDoc } from '../../lib/docs';
import { REPO_SITE } from '../../lib/site';

interface Props {
  idioma: Idioma;
  doc: CollectionEntry<'docs'>;
}

const { idioma, doc } = Astro.props;
const { Content } = await render(doc);
const outro = outroIdioma(idioma);
const todos = await getCollection('docs');
const traduzido = traducao(todos, doc, outro);
// A posição do guia na ordem do menu lateral dá o "Guia X de Y".
const lista = docsDoIdioma(todos, idioma);
const posicao = lista.findIndex((d) => d.id === doc.id);
const alternativa = traduzido ? urlDoc(outro, traduzido) : rota(outro, 'docs');
---

<DocsLayout
  idioma={idioma}
  titulo={doc.data.titulo}
  descricao={doc.data.descricao}
  alternativa={alternativa}
  traduzida={Boolean(traduzido)}
  atual={doc}
>
  <!-- Topo sem bloco: o número, a posição e o título branco direto sobre o fundo. -->
  <header class="cabeca" style={`view-transition-name: guia-${doc.data.chave}`}>
    <p class="meta">
      <span>{`${t(idioma, 'docs_guia')} ${posicao + 1} ${t(idioma, 'docs_de')} ${lista.length}`}</span>
    </p>
    <h1>{doc.data.titulo}</h1>
  </header>
  <Content />
  <!-- Abre este arquivo no editor do GitHub: quem achar um erro já propõe a correção. -->
  <p class="fonte">
    <a class="link-seta discreto" href={`${REPO_SITE}/edit/main/src/content/docs/${doc.id}.md`}>
      {t(idioma, 'docs_editar')}
    </a>
  </p>
</DocsLayout>

<style>
  /* Topo do guia: o número, a posição e o título, sem bloco. */
  .cabeca {
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.85rem;
    margin: 0 0 1.25rem;
    font-size: 0.9rem;
    font-weight: 600;
  }
  .cabeca h1 {
    margin: 0;
    font-size: clamp(2.2rem, 6vw, 3.5rem);
    letter-spacing: -0.04em;
    color: var(--cor-texto);
  }
  .fonte {
    margin-top: 3rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--cor-borda);
    font-size: 0.92rem;
  }
  .discreto {
    color: var(--cor-texto-suave);
    text-decoration-color: var(--cor-borda-forte);
  }
</style>
