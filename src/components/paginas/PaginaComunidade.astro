---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import CartaoProjeto from '../CartaoProjeto.astro';
import { outroIdioma, rota, t, type Idioma } from '../../lib/i18n';
import { ordenarPorData, TIPOS } from '../../lib/comunidade';
import { urlEnviarProjeto } from '../../lib/links';

interface Props {
  idioma: Idioma;
}

const { idioma } = Astro.props;
const projetos = ordenarPorData(await getCollection('comunidade'));
---

<Base idioma={idioma} titulo={t(idioma, 'comunidade_titulo')} alternativa={rota(outroIdioma(idioma), 'comunidade')}>
  <section class="conteiner">
    <header class="topo">
      <div>
        <h1>{t(idioma, 'comunidade_titulo')}</h1>
        <p class="intro">{t(idioma, 'comunidade_intro')}</p>
      </div>
      <a class="botao botao-primario" href={urlEnviarProjeto(idioma)}>{t(idioma, 'comunidade_enviar')}</a>
    </header>

    <div class="filtros" role="group" aria-label={t(idioma, 'filtro_rotulo')}>
      <button type="button" data-filtro="todos" aria-pressed="true">{t(idioma, 'filtro_todos')}</button>
      {TIPOS.map((tipo) => <button type="button" data-filtro={tipo} aria-pressed="false">{t(idioma, `filtro_${tipo}`)}</button>)}
    </div>

    <ul class="grade">
      {projetos.map((projeto) => <CartaoProjeto projeto={projeto} idioma={idioma} nivel={2} />)}
    </ul>
    <p class="vazio" hidden>{t(idioma, 'comunidade_vazio')}</p>
  </section>
</Base>

<script>
  const botoes = document.querySelectorAll<HTMLButtonElement>('[data-filtro]');
  const cartoes = document.querySelectorAll<HTMLElement>('.grade > [data-tipo]');
  const vazio = document.querySelector<HTMLElement>('.vazio');
  for (const botao of botoes) {
    botao.addEventListener('click', () => {
      const filtro = botao.dataset.filtro;
      let visiveis = 0;
      for (const cartao of cartoes) {
        const mostra = filtro === 'todos' || cartao.dataset.tipo === filtro;
        cartao.hidden = !mostra;
        if (mostra) visiveis++;
      }
      for (const b of botoes) b.setAttribute('aria-pressed', String(b === botao));
      if (vazio) vazio.hidden = visiveis > 0;
    });
  }
</script>

<style>
  section {
    padding-block: 3rem;
  }
  .topo {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem;
    margin-bottom: 2rem;
  }
  h1 {
    font-size: clamp(2rem, 6vw, 3.2rem);
  }
  .intro {
    color: var(--cor-texto-suave);
    max-width: 60ch;
    margin: 0;
  }
  .filtros {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
  }
  .filtros button {
    font: inherit;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--cor-texto-suave);
    background: transparent;
    border: 1px solid var(--cor-borda);
    border-radius: 999px;
    padding: 0.4rem 0.95rem;
    cursor: pointer;
  }
  .filtros button[aria-pressed='true'] {
    background: var(--cor-destaque);
    border-color: var(--cor-destaque);
    color: var(--cor-texto);
  }
  .grade {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
    padding: 0;
    margin: 0;
  }
  @media (min-width: 640px) {
    .grade {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 960px) {
    .grade {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .vazio {
    color: var(--cor-texto-suave);
  }
</style>
