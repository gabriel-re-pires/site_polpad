---
// Comunidade: título grande, o texto de abertura, o botão de enviar, filtros com a contagem
// de cada tipo e a grade de projetos.
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import CartaoProjeto from '../CartaoProjeto.astro';
import { outroIdioma, rota, t, type Idioma } from '../../lib/i18n';
import { ordenarPorData, TIPOS } from '../../lib/comunidade';
import { urlEnviarProjeto } from '../../lib/links';

interface Props {
  idioma: Idioma;
}

const { idioma } = Astro.props;
const projetos = ordenarPorData(await getCollection('comunidade'));
const contagem = (tipo: string) => projetos.filter((p) => p.data.tipo === tipo).length;
---

<Base
  idioma={idioma}
  titulo={t(idioma, 'comunidade_titulo')}
  descricao={t(idioma, 'comunidade_descricao')}
  alternativa={rota(outroIdioma(idioma), 'comunidade')}>
  <div class="conteiner pagina">
    <header class="cabeca">
      <h1>{t(idioma, 'comunidade_titulo')}</h1>
      <p class="intro">{t(idioma, 'comunidade_intro')}</p>
      <p class="intro">{t(idioma, 'comunidade_intro2')}</p>
      <p class="intro">{t(idioma, 'comunidade_intro3')}</p>
    </header>

    <div class="barra">
      <div class="filtros" role="group" aria-label={t(idioma, 'filtro_rotulo')}>
        <button type="button" data-filtro="todos" aria-pressed="true">
          {t(idioma, 'filtro_todos')}{' '}
          <span class="conta">{projetos.length}</span>
        </button>
        {
          TIPOS.map((tipo) => (
            <button type="button" data-filtro={tipo} aria-pressed="false">
              {t(idioma, `filtro_${tipo}`)}{' '}
              <span class="conta">{contagem(tipo)}</span>
            </button>
          ))
        }
      </div>
      <a class="botao enviar" href={urlEnviarProjeto(idioma)}>{t(idioma, 'comunidade_enviar')}</a>
    </div>

    <!-- Fica sempre na página, vazio: quando um filtro não acha nada, o texto entra e o
         leitor de tela anuncia. -->
    <p class="vazio" role="status" data-texto={t(idioma, 'comunidade_vazio')}></p>

    <ul class="grade">
      {projetos.map((projeto) => <CartaoProjeto projeto={projeto} idioma={idioma} nivel={2} />)}
    </ul>
  </div>
</Base>

<script>
  const botoes = document.querySelectorAll<HTMLButtonElement>('[data-filtro]');
  const cartoes = document.querySelectorAll<HTMLElement>('.grade > [data-tipo]');
  const vazio = document.querySelector<HTMLElement>('.vazio');

  function filtrar(botao: HTMLButtonElement) {
    const filtro = botao.dataset.filtro;
    let visiveis = 0;
    for (const cartao of cartoes) {
      const mostra = filtro === 'todos' || cartao.dataset.tipo === filtro;
      cartao.hidden = !mostra;
      if (mostra) visiveis++;
    }
    for (const b of botoes) b.setAttribute('aria-pressed', String(b === botao));
    if (vazio) vazio.textContent = visiveis > 0 ? '' : (vazio.dataset.texto ?? '');
  }

  // O filtro escolhido vai para o endereço (?tipo=case): dá para compartilhar o link
  // já filtrado, e ele volta ao recarregar a página.
  for (const botao of botoes) {
    botao.addEventListener('click', () => {
      filtrar(botao);
      const filtro = botao.dataset.filtro;
      const url = new URL(location.href);
      if (filtro === 'todos') url.searchParams.delete('tipo');
      else url.searchParams.set('tipo', filtro ?? '');
      history.replaceState(null, '', url);
    });
  }
  const pedido = new URLSearchParams(location.search).get('tipo');
  const inicial = [...botoes].find((b) => b.dataset.filtro === pedido);
  if (inicial) filtrar(inicial);
</script>

<style>
  .pagina {
    padding-block: clamp(2.5rem, 9vw, 7rem) 0;
  }

  /* Título grande, como o de Docs e o de Download. */
  .cabeca {
    margin-bottom: clamp(2.5rem, 6vw, 4rem);
  }
  h1 {
    margin: 0 0 clamp(1.75rem, 3.5vw, 2.5rem);
    font-size: clamp(2.4rem, 11vw, 9rem);
    line-height: 0.85;
    letter-spacing: -0.05em;
  }
  /* Texto de abertura no mesmo padrão das outras páginas: largura toda, justificado. */
  .intro {
    margin: 0 0 1.5rem;
    color: var(--cor-texto-corpo);
    font-size: clamp(1.02rem, 1.8vw, 1.2rem);
    line-height: 1.75;
    text-align: var(--alinhar-texto);
    hyphens: auto;
  }
  /* Os filtros à esquerda e o botão de enviar no canto direito, na mesma linha. */
  .barra {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 1.5rem;
    margin-bottom: 2rem;
  }
  .enviar {
    padding: 0.55rem 1.1rem;
    background: var(--cor-lima);
    color: var(--cor-tinta);
    border-color: var(--cor-lima);
    font-size: 0.95rem;
  }
  .enviar:hover {
    background: var(--cor-lima-forte);
    border-color: var(--cor-lima-forte);
  }

  /* Filtros com a contagem de projetos de cada tipo. O escolhido fica roxo. */
  .filtros {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }
  .filtros button {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.55rem 0.65rem 0.55rem 1.1rem;
    border: 0;
    border-radius: 6px;
    background: transparent;
    box-shadow: inset 0 0 0 1px var(--cor-borda-forte);
    color: var(--cor-texto-suave);
    font: inherit;
    font-size: 0.95rem;
    font-weight: 600;
    cursor: pointer;
    transition:
      color 0.15s,
      background-color 0.15s,
      box-shadow 0.15s;
  }
  .filtros button:hover {
    color: var(--cor-texto);
    box-shadow: inset 0 0 0 1px var(--cor-texto-suave);
  }
  .conta {
    display: grid;
    place-items: center;
    min-width: 1.6rem;
    height: 1.6rem;
    padding-inline: 0.4rem;
    border-radius: 4px;
    background: rgb(255 255 255 / 0.1);
    font-size: 0.8rem;
  }
  .filtros button[aria-pressed='true'] {
    background: var(--cor-roxo);
    box-shadow: none;
    color: var(--cor-texto);
  }
  .filtros button[aria-pressed='true'] .conta {
    background: rgb(255 255 255 / 0.2);
    color: var(--cor-texto);
  }

  .vazio {
    margin: 0 0 1.25rem;
    color: var(--cor-texto-suave);
  }
  .vazio:empty {
    display: none;
  }

  .grade {
    display: grid;
    grid-template-columns: 1fr;
    gap: calc(var(--vao) * 1.5);
    margin: 0;
    padding: 0;
  }
  @media (min-width: 640px) {
    .grade {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 960px) {
    .grade {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  /* No celular, os filtros ficam numa linha só, que rola de lado, e o botão de enviar ocupa
     a largura toda embaixo deles. */
  @media (max-width: 640px) {
    .filtros {
      flex: 1 1 100%;
      flex-wrap: nowrap;
      min-width: 0;
      margin-inline: calc(-1 * var(--gutter));
      padding-inline: var(--gutter);
      overflow-x: auto;
      scrollbar-width: none;
    }
    .filtros::-webkit-scrollbar {
      display: none;
    }
    .filtros button {
      flex-shrink: 0;
    }
    .enviar {
      width: 100%;
      padding-block: 0.8rem;
    }
  }
</style>
