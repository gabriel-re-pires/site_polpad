---
import Base from '../../layouts/Base.astro';
import Hero from '../Hero.astro';
import Ideia from '../Ideia.astro';
import ProjetoPolpad from '../ProjetoPolpad.astro';
import Modelo3D from '../Modelo3D.astro';
import Fichas from '../Fichas.astro';
import Passos from '../Passos.astro';
import { outroIdioma, rota, t, type Idioma } from '../../lib/i18n';

interface Props {
  idioma: Idioma;
}

const { idioma } = Astro.props;
---

<Base idioma={idioma} titulo="Polpad" alternativa={rota(outroIdioma(idioma), 'inicio')}>
  <Hero idioma={idioma} />
  <ProjetoPolpad idioma={idioma} />
  <Modelo3D idioma={idioma} />
  <Fichas idioma={idioma} />
  <Passos idioma={idioma} />
  <Ideia idioma={idioma} />
  <section class="conteiner" aria-labelledby="cta-titulo">
    <div class="cta">
      <h2 id="cta-titulo">{t(idioma, 'cta_titulo')}</h2>
      <a class="botao botao-grande iniciar" href={rota(idioma, 'docs')}>{t(idioma, 'cta_montar')}</a>
    </div>
  </section>
</Base>

<style>
  /* Bloco roxo chapado: o fechamento da página. */
  .cta {
    position: relative;
    /* O título à esquerda e o botão à direita, na mesma linha; sem espaço, o botão
       desce para baixo do título. */
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem 2rem;
    margin-top: var(--secao);
    padding: clamp(1.1rem, 2.4vw, 1.75rem) clamp(2rem, 6vw, 4.5rem);
    border-radius: 6px;
    background: var(--cor-roxo);
    color: var(--cor-texto);
  }
  .cta h2 {
    font-size: clamp(1.8rem, 4.2vw, 2.8rem);
    margin: 0;
  }
  /* Um botão só, que leva para as docs: contorno e letras brancas; ao passar o
     mouse, vira um bloco branco com letras roxas. */
  .iniciar {
    background: transparent;
    color: var(--cor-texto);
    border-color: rgb(255 255 255 / 0.5);
  }
  .iniciar:hover {
    background: var(--cor-texto);
    border-color: var(--cor-texto);
    color: var(--cor-roxo);
  }
  @media (max-width: 560px) {
    .cta {
      padding: 1.75rem 1.5rem;
    }
    .iniciar {
      width: 100%;
    }
  }
</style>
