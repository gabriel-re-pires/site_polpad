---
// Ficha técnica, logo abaixo do modelo 3D. Os valores são iguais nos dois idiomas, só a legenda muda.
import { t, type Idioma } from '../lib/i18n';

interface Props {
  idioma: Idioma;
}

const { idioma } = Astro.props;
const fichas = [
  { valor: '18 switches', legenda: t(idioma, 'ficha_teclas') },
  { valor: 'OLED 128×64', legenda: t(idioma, 'ficha_display') },
  { valor: 'ESP32\u2011C3', legenda: t(idioma, 'ficha_chip') },
  { valor: '3D PLA', legenda: t(idioma, 'ficha_case') },
];
---

<div class="conteiner bloco">
  <ul class="fichas">
    {
      fichas.map((f) => (
        <li class="ficha">
          <strong>{f.valor}</strong>
          <span>{f.legenda}</span>
        </li>
      ))
    }
  </ul>
</div>

<style>
  .bloco {
    margin-top: clamp(2.5rem, 5vw, 4rem);
  }
  .fichas {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--vao);
  }
  @media (min-width: 720px) {
    .fichas {
      grid-template-columns: 1.1fr 1fr 1fr 1fr;
    }
  }
  .ficha {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 1.25rem;
    min-height: 9.5rem;
    padding: clamp(1.1rem, 2.5vw, 1.5rem);
    border-radius: var(--raio-grande);
  }
  .ficha strong {
    font-family: var(--fonte-titulo);
    font-weight: 800;
    font-size: clamp(1.5rem, 3vw, 2.1rem);
    letter-spacing: -0.03em;
    line-height: 1;
  }
  .ficha span {
    font-size: 1.05rem;
    line-height: 1.4;
  }
  /* Todos no mesmo estilo: contorno fino sobre o fundo escuro. */
  .ficha {
    box-shadow: inset 0 0 0 1px var(--cor-borda-forte);
  }
  .ficha span {
    color: var(--cor-texto-suave);
  }
  /* No celular, em duas colunas estreitas: título menor, sem altura mínima. */
  @media (max-width: 560px) {
    .ficha {
      min-height: 0;
      gap: 0.9rem;
    }
    .ficha strong {
      font-size: 1.3rem;
    }
    .ficha span {
      font-size: 0.95rem;
    }
  }
</style>
