---
// Ficha técnica, logo abaixo do modelo 3D, com os botões de download e do código
// embaixo. Os valores são iguais nos dois idiomas, só a legenda muda.
import { rota, t, type Idioma } from '../lib/i18n';
import { REPO_POLPAD } from '../lib/site';
import IconeGithub from './IconeGithub.astro';

interface Props {
  idioma: Idioma;
}

const { idioma } = Astro.props;
const fichas = [
  { valor: '18', legenda: t(idioma, 'ficha_teclas'), estilo: 'lima' },
  { valor: '128×64', legenda: t(idioma, 'ficha_display'), estilo: 'escuro' },
  { valor: 'ESP32-C3', legenda: t(idioma, 'ficha_chip'), estilo: 'escuro' },
  { valor: 'GPL-3.0', legenda: t(idioma, 'ficha_licenca'), estilo: 'contorno' },
];
---

<div class="conteiner bloco">
  <ul class="fichas">
    {
      fichas.map((f) => (
        <li class:list={['ficha', f.estilo]}>
          <strong>{f.valor}</strong>
          <span>{f.legenda}</span>
        </li>
      ))
    }
  </ul>
  <div class="botoes">
    <a class="botao botao-primario botao-grande" href={rota(idioma, 'baixar')}>
      {t(idioma, 'hero_baixar')}
    </a>
    <a class="botao botao-secundario botao-grande" href={REPO_POLPAD}>
      <IconeGithub />
      {t(idioma, 'hero_github')}
    </a>
  </div>
</div>

<style>
  .bloco {
    margin-top: clamp(2rem, 4vw, 3rem);
  }
  .fichas {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--vao);
  }
  @media (min-width: 720px) {
    .fichas {
      grid-template-columns: 1.1fr 1fr 1fr 1fr;
    }
  }
  .ficha {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 1.25rem;
    min-height: 9.5rem;
    padding: clamp(1.1rem, 2.5vw, 1.5rem);
    border-radius: var(--raio-grande);
  }
  .ficha strong {
    font-family: var(--fonte-titulo);
    font-weight: 800;
    font-size: clamp(1.25rem, 2.6vw, 1.75rem);
    letter-spacing: -0.03em;
    line-height: 1;
  }
  .ficha span {
    font-size: 0.92rem;
    line-height: 1.4;
  }
  .escuro {
    background: var(--cor-fundo-elevado);
  }
  .escuro span,
  .contorno span {
    color: var(--cor-texto-suave);
  }
  .contorno {
    box-shadow: inset 0 0 0 1px var(--cor-borda-forte);
  }
  .lima {
    background: var(--cor-lima);
    color: var(--cor-tinta);
  }
  .lima strong {
    font-size: clamp(3rem, 7vw, 4.5rem);
    letter-spacing: -0.05em;
  }
  .lima span {
    font-weight: 600;
  }
  .botoes {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: clamp(1.5rem, 3vw, 2rem);
  }
  @media (max-width: 480px) {
    .botoes {
      flex-direction: column;
    }
  }
</style>
