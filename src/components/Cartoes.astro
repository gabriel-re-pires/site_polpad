---
import { rota, t, type Idioma, type ChaveTexto } from '../lib/i18n';
import { urlMontagem } from '../lib/links';

interface Props {
  idioma: Idioma;
}

const { idioma } = Astro.props;

const cartoes: { chave: 'hardware' | 'software' | 'firmware'; href: string }[] = [
  { chave: 'hardware', href: urlMontagem(idioma) },
  { chave: 'software', href: rota(idioma, 'baixar') },
  { chave: 'firmware', href: rota(idioma, 'baixar') },
];
const texto = (c: string, sufixo = '') => t(idioma, `cartao_${c}${sufixo}` as ChaveTexto);
---

<section class="conteiner">
  <h2>{t(idioma, 'cartoes_titulo')}</h2>
  <ul class="grade">
    {
      cartoes.map(({ chave, href }) => (
        <li class="cartao">
          <h3>{texto(chave)}</h3>
          <p>{texto(chave, '_texto')}</p>
          <a href={href}>
            {texto(chave, '_link')} <span aria-hidden="true">→</span>
          </a>
        </li>
      ))
    }
  </ul>
</section>

<style>
  section {
    padding-block: 2rem;
  }
  h2 {
    font-size: clamp(1.4rem, 3.5vw, 2rem);
    text-align: center;
    margin-bottom: 2rem;
  }
  .grade {
    display: grid;
    gap: 1.25rem;
    padding: 0;
    margin: 0;
    list-style: none;
  }
  @media (min-width: 840px) {
    .grade {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .cartao {
    border: 1px solid var(--cor-borda);
    border-radius: var(--raio);
    background: var(--cor-fundo-elevado);
    padding: 1.5rem;
  }
  h3 {
    font-size: 1.15rem;
  }
  p {
    color: var(--cor-texto-suave);
  }
  a {
    font-weight: 600;
    text-decoration: none;
  }
  a:hover {
    color: var(--cor-destaque-forte);
  }
</style>
