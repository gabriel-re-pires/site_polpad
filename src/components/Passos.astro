---
// Montar, instalar e configurar: é uma sequência de verdade, por isso os números.
import { rota, t, type Idioma, type ChaveTexto } from '../lib/i18n';
import { urlDocPorChave, urlMontagem } from '../lib/links';

interface Props {
  idioma: Idioma;
}

const { idioma } = Astro.props;

const passos: { chave: 'montar' | 'instalar' | 'configurar'; href: string }[] = [
  { chave: 'montar', href: urlMontagem(idioma) },
  { chave: 'instalar', href: rota(idioma, 'baixar') },
  { chave: 'configurar', href: urlDocPorChave(idioma, 'firmware') },
];
const texto = (c: string, sufixo = '') => t(idioma, `passo_${c}${sufixo}` as ChaveTexto);
---

<section class="conteiner passos" aria-labelledby="passos-titulo">
  <div class="painel">
    <div class="secao-cabeca">
      <h2 id="passos-titulo">{t(idioma, 'passos_titulo')}</h2>
    </div>
    <ol class="lista">
      {
        passos.map(({ chave, href }, i) => (
          <li class="passo">
            <span class="numero" aria-hidden="true">
              {i + 1}
            </span>
            <h3>{texto(chave)}</h3>
            <p>{texto(chave, '_texto')}</p>
            <a class="chip" href={href}>
              {texto(chave, '_link')}
            </a>
            {i < passos.length - 1 && (
              <span class="seta" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="24" height="24">
                  <path d="M4 12h15M13 5.5l6.5 6.5-6.5 6.5" />
                </svg>
              </span>
            )}
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .passos {
    padding-block: var(--secao) 0;
  }
  /* Um painel roxo grande com os passos em cartões claros por dentro. */
  .painel {
    padding: clamp(1.25rem, 3vw, 2rem) clamp(1rem, 4vw, 3rem) clamp(2.25rem, 4vw, 3rem);
    border-radius: 6px;
    background: var(--cor-roxo);
  }
  /* Sem subtítulo: o título ocupa a linha toda, se couber. */
  .secao-cabeca {
    max-width: none;
    margin-bottom: clamp(1.25rem, 3vw, 2rem);
  }
  .secao-cabeca h2 {
    margin-bottom: 0;
  }
  .lista {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 3.75rem;
  }
  @media (min-width: 840px) {
    .lista {
      grid-template-columns: repeat(3, 1fr);
      gap: clamp(2rem, 4vw, 3.5rem);
    }
  }
  .passo {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    min-height: 17rem;
    padding: clamp(1.5rem, 3vw, 2rem) clamp(1.5rem, 3vw, 2rem) 2.75rem;
    border-radius: 20px;
    background: var(--cor-texto);
    color: var(--cor-tinta);
  }
  /* Numeral gigante em contorno: o grafismo de letra vazada da marca. */
  .numero {
    font-family: var(--fonte-titulo);
    font-weight: 800;
    font-size: clamp(6rem, 12vw, 8.5rem);
    line-height: 0.8;
    letter-spacing: -0.05em;
    color: var(--cor-texto);
    /* O contorno cresce para fora da letra (o miolo cobre a metade de dentro). Passar
       de uns 6px fecha as fendas do 3. */
    -webkit-text-stroke: 5px var(--cor-tinta);
    paint-order: stroke fill;
    padding-bottom: 1.75rem;
  }
  h3 {
    font-size: clamp(1.4rem, 2.6vw, 1.7rem);
    margin-bottom: 0.85rem;
  }
  p {
    margin: 0;
    color: rgb(14 11 20 / 0.75);
    line-height: 1.65;
    text-align: var(--alinhar-texto);
    hyphens: auto;
  }
  /* O link é uma pílula que passa da borda de baixo do cartão para o roxo, por cima, sem recorte. */
  .chip {
    position: absolute;
    left: clamp(1.5rem, 3vw, 2rem);
    bottom: 0;
    translate: 0 50%;
    display: inline-flex;
    align-items: center;
    min-height: 2.9rem;
    padding: 0.55rem 1.25rem;
    border-radius: 10px;
    background: var(--cor-tinta);
    color: var(--cor-texto);
    font-weight: 600;
    text-decoration: none;
    transition:
      background-color 0.15s,
      color 0.15s;
  }
  .chip:hover {
    background: var(--cor-lima);
    color: var(--cor-tinta);
  }
  .chip:focus-visible {
    outline: 2px solid var(--cor-lima);
    outline-offset: 7px;
  }
  /* Um botão branco com seta liga um passo ao seguinte, por cima do vão. */
  .seta {
    position: absolute;
    right: 1.75rem;
    bottom: -1.5rem;
    rotate: 90deg;
    display: grid;
    place-items: center;
    width: 4.25rem;
    height: 4.25rem;
    border-radius: 50%;
    background: var(--cor-texto);
    color: var(--cor-tinta);
    box-shadow: 0 0 0 5px var(--cor-roxo);
    pointer-events: none;
  }
  .seta svg {
    width: 2.1rem;
    height: 2.1rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 2.75;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  /* Com os cartões lado a lado, o link fica no canto direito do cartão. No celular
     ele fica à esquerda, porque o canto direito é da seta que desce. */
  @media (min-width: 840px) {
    .chip {
      left: auto;
      right: 0.9rem;
    }
  }
  @media (min-width: 840px) {
    .seta {
      right: auto;
      bottom: auto;
      /* O centro fica um pouco para dentro do cartão do passo anterior. */
      left: calc(100% - 0.4rem);
      top: 38%;
      translate: -50% -50%;
      rotate: 0deg;
    }
  }
  /* No celular, um cartão embaixo do outro: sem a altura mínima, que deixava vazio. */
  @media (max-width: 839px) {
    .passo {
      min-height: 0;
      padding-bottom: 3.25rem;
    }
  }
</style>
