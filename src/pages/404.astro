---
// Um 404 só para o site todo: o texto vem nos dois idiomas.
import Base from '../layouts/Base.astro';
import { rota, t } from '../lib/i18n';
---

<Base idioma="pt-br" titulo={t('pt-br', 'nao_encontrado_titulo')} alternativa={rota('en', 'inicio')} indexar={false}>
  <section class="conteiner">
    <p class="codigo" aria-hidden="true">404</p>
    <h1>{t('pt-br', 'nao_encontrado_titulo')}</h1>
    <p class="texto">O endereço pode ter mudado ou estar digitado errado. Estes caminhos levam ao que a maioria procura:</p>
    <div class="botoes">
      <a class="botao botao-primario" href={rota('pt-br', 'inicio')}>Página inicial</a>
      <a class="botao botao-secundario" href={rota('pt-br', 'baixar')}>Baixar</a>
      <a class="botao botao-secundario" href={rota('pt-br', 'docs')}>Docs</a>
    </div>
    <h2 lang="en">{t('en', 'nao_encontrado_titulo')}</h2>
    <p lang="en" class="texto">
      <a href={rota('en', 'inicio')}>Home</a>{' · '}<a href={rota('en', 'baixar')}>Download</a>{' · '}<a
        href={rota('en', 'docs')}>Docs</a
      >
    </p>
  </section>
</Base>

<style>
  section {
    padding-block: 5rem;
    text-align: center;
  }
  .codigo {
    font-family: var(--fonte-titulo);
    font-size: clamp(4rem, 18vw, 9rem);
    line-height: 1;
    color: var(--cor-destaque);
    margin: 0 0 1rem;
  }
  h1 {
    font-size: clamp(1.6rem, 5vw, 2.4rem);
  }
  h2 {
    font-size: 1.2rem;
    color: var(--cor-texto-suave);
    margin-top: 2.5rem;
  }
  .texto {
    color: var(--cor-texto-suave);
    max-width: 34rem;
    margin: 0 auto 2rem;
  }
  .texto a {
    color: var(--cor-texto);
    font-weight: 600;
    text-underline-offset: 3px;
  }
  .botoes {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
  }
  h2 {
    margin-top: 3.5rem !important;
    padding-top: 2.5rem;
    border-top: 1px solid var(--cor-borda);
    max-width: 34rem;
    margin-inline: auto;
  }
</style>
