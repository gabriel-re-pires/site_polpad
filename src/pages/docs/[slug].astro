---
import { getCollection } from 'astro:content';
import PaginaDoc from '../../components/paginas/PaginaDoc.astro';
import { docsDoIdioma, slugDoDoc } from '../../lib/docs';

export async function getStaticPaths() {
  const docs = docsDoIdioma(await getCollection('docs'), 'pt-br');
  return docs.map((doc) => ({ params: { slug: slugDoDoc(doc.id) }, props: { doc } }));
}

const { doc } = Astro.props;
---

<PaginaDoc idioma="pt-br" doc={doc} />
