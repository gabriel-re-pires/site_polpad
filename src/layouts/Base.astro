---
import '../styles/global.css';
import Cabecalho from '../components/Cabecalho.astro';
import Rodape from '../components/Rodape.astro';
import { langHtml, linksAlternativos, t, type Idioma } from '../lib/i18n';

interface Props {
  idioma: Idioma;
  titulo: string;
  descricao?: string;
  /** URL desta mesma página no outro idioma. */
  alternativa: string;
  /** false quando `alternativa` não é tradução desta página (doc só num idioma). */
  traduzida?: boolean;
  /** false na 404: sem canonical, sem hreflang e fora dos buscadores. */
  indexar?: boolean;
}

const {
  idioma,
  titulo,
  descricao = t(idioma, 'site_descricao'),
  alternativa,
  traduzida = true,
  indexar = true,
} = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const tituloCompleto = titulo === 'Polpad' ? titulo : `${titulo} · Polpad`;
const canonica = new URL(Astro.url.pathname, Astro.site).href;
const alternativos = indexar
  ? linksAlternativos(idioma, canonica, traduzida ? new URL(alternativa, Astro.site).href : null)
  : [];
---

<!doctype html>
<html lang={langHtml(idioma)}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tituloCompleto}</title>
    <meta name="description" content={descricao} />
    <meta name="theme-color" content="#0E0B14" />
    {indexar ? <link rel="canonical" href={canonica} /> : <meta name="robots" content="noindex" />}
    {alternativos.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
    <link rel="icon" href={`${base}favicon.ico`} sizes="any" />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={`${base}apple-touch-icon.png`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400;500;600&family=Silkscreen&family=Unbounded:wght@600;800&display=swap"
    />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Polpad" />
    <meta property="og:locale" content={idioma === 'pt-br' ? 'pt_BR' : 'en_US'} />
    {indexar && <meta property="og:url" content={canonica} />}
    <meta property="og:title" content={tituloCompleto} />
    <meta property="og:description" content={descricao} />
    <meta property="og:image" content={new URL(`${base}icon-512.png`, Astro.site).href} />
    <meta property="og:image:alt" content="Polpad" />
    <meta name="twitter:card" content="summary" />
  </head>
  <body>
    <a class="pular" href="#conteudo">{t(idioma, 'pular_conteudo')}</a>
    <Cabecalho idioma={idioma} />
    <main id="conteudo" tabindex="-1">
      <slot />
    </main>
    <Rodape idioma={idioma} alternativa={alternativa} />
  </body>
</html>
