---
import '../styles/global.css';
import Cabecalho from '../components/Cabecalho.astro';
import Rodape from '../components/Rodape.astro';
import { langHtml, t, type Idioma } from '../lib/i18n';

interface Props {
  idioma: Idioma;
  titulo: string;
  descricao?: string;
  /** URL desta mesma página no outro idioma. */
  alternativa: string;
}

const { idioma, titulo, descricao = t(idioma, 'site_descricao'), alternativa } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const tituloCompleto = titulo === 'Polpad' ? titulo : `${titulo} · Polpad`;
---

<!doctype html>
<html lang={langHtml(idioma)}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tituloCompleto}</title>
    <meta name="description" content={descricao} />
    <meta name="theme-color" content="#0E0B14" />
    <link rel="icon" href={`${base}favicon.ico`} sizes="any" />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={`${base}apple-touch-icon.png`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600&family=Unbounded:wght@800&display=swap"
    />
    <meta property="og:title" content={tituloCompleto} />
    <meta property="og:description" content={descricao} />
    <meta property="og:image" content={new URL(`${base}icon-512.png`, Astro.site).href} />
  </head>
  <body>
    <Cabecalho idioma={idioma} alternativa={alternativa} />
    <main>
      <slot />
    </main>
    <Rodape idioma={idioma} />
  </body>
</html>
